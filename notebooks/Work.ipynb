    {
      "cell_type": "code",
      "source": [
        "# Define DataBlock with IndexSplitter to respect your manual split\n",
        "plant_db = DataBlock(\n",
        "    blocks=(ImageBlock, CategoryBlock),\n",
        "    get_x=lambda x: Path(image_dir) / x['filename'],    # image directory\n",
        "    get_y=lambda x: x['damage'],                        # target variable\n",
        "    splitter=IndexSplitter(valid_idx),\n",
        "    batch_tfms=aug_transforms()\n",
        ")"
      ],
      "metadata": {
        "id": "8V5rEHbEFWoh"
      },
      "execution_count": 45,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Create DataLoaders from the combined df\n",
        "dls = plant_db.dataloaders(df_combined, bs=32)"
      ],
      "metadata": {
        "id": "xxfAPSkMFm_5"
      },
      "execution_count": 46,
      "outputs": []
    },
